<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Bluey.Host</RootNamespace>
    <!-- WPF reads PerMonitorV2 from app.manifest. WinForms also warns about that same block. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <StartupObject></StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bluey.Core\Bluey.Core.csproj" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <Content Include="supertonic_speak.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
